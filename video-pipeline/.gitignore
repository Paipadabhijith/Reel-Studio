.env
.venv/
__pycache__/
*.egg-info/
node_modules/
.DS_Store
projects/*/build/
projects/*/out/
!projects/demo/
*.lock
# generated on first use: downloaded boundary data and the .blend built from it
blender/data/
blender/templates/*.blend
# project media is re-fetchable (stock) or personal (your recordings): keep only the project text in git.
# files committed before these lines (the demo's first images and narration) stay tracked.
projects/*/assets/images/
projects/*/assets/videos/
projects/*/audio/
*.bak
